        <!-- Ervo as a pop-up over other apps: "Hey Ervo" and the phone's assistant button open this -->
        <activity
            android:name=".VoiceActivity"
            android:exported="true"
            android:theme="@style/Theme.Ervo.Overlay"
            android:launchMode="singleInstance"
            android:taskAffinity="app.ervo.voice"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <!-- Lets you pick Ervo as the phone's digital assistant app -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "Hey Ervo": listens only while you have it turned on, with a notification showing -->
        <service
            android:name=".WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Weather heads-up before you leave (only when you turn it on in Ervo) -->
        <receiver
            android:name=".WeatherAlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Looks for a new Ervo a few times a day and shows one notification when it's ready -->
        <receiver
            android:name=".UpdateCheckReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Shares a downloaded update with Android's installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Health Connect's "Read privacy policy" link (Android 13 and older) -->
        <activity
            android:name=".PrivacyActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- The same link on Android 14 and newer -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".PrivacyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
