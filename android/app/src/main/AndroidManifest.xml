<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Weather in the greeting (city-level only). Ervo asks first. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Weather and news. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Steps on the Ervo Stats page, through Health Connect. Ervo asks first. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- In-app updates: Android still asks the user before installing anything. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Finding and removing events you ask Ervo to remove. Ervo asks first, and deletes only what you tap. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Ervo's listening screen and "Hey Ervo". Ervo asks first; "Hey Ervo" is off until you turn it on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets "Hey Ervo" open Ervo while you're in another app (you turn this on in Settings). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Calling people in your contacts when you ask. Ervo never calls emergency numbers. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Timers and alarms in your phone's Clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Weather heads-up before you leave: plans the next check again after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets Ervo find the phone's speech recognizer, text-to-speech and Health Connect (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- The phone's speech recognizer, for Ervo's own listening screen -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- The phone's calendar app, for "Phone calendar" -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

